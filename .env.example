# Copy to .env and fill in real values. Never commit .env.

# --- Required ---
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/smart-school
# Long random secret used to sign JWTs (32+ chars), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret

# --- Optional ---
# HTTP port (default 8080)
PORT=8080
# "production" hides internal error details and stack traces
NODE_ENV=development
# JWT lifetime (jsonwebtoken format, default 1d)
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed browser origins. When unset, defaults to the
# deployed frontend plus localhost:5173 / 127.0.0.1:5173 / localhost:3000
CORS_ORIGINS=https://smart-school-management-system-frontend.onrender.com,http://localhost:5173
# Express "trust proxy" setting (default 1 = one reverse proxy, e.g. Render)
TRUST_PROXY=1
# Groq API key for the AI assistant and analytics endpoints
GROQ_API_KEY=
